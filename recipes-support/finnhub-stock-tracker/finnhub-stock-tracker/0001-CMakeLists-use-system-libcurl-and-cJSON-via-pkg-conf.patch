From: Kumar Bala <kumar@renovatio.systems>
Subject: CMakeLists: use system libcurl and cJSON via pkg-config

Build against the libcurl and cJSON provided by the distro instead of
the vendored third_party submodules, and add an install rule.

Upstream-Status: Inappropriate [Yocto packaging: upstream vendors deps]
Signed-off-by: Kumar Bala <kumar@renovatio.systems>
---
 CMakeLists.txt | 40 ++++++++--------------------------------
 1 file changed, 8 insertions(+), 32 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 1fe4af3..0a83686 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,43 +1,19 @@
 cmake_minimum_required(VERSION 3.16)
 project(stock_monitor C)
 
+include(GNUInstallDirs)
+
 set(CMAKE_C_STANDARD 11)
 set(CMAKE_C_STANDARD_REQUIRED ON)
 
-if(NOT EXISTS "${CMAKE_SOURCE_DIR}/third_party/curl/CMakeLists.txt" OR
-   NOT EXISTS "${CMAKE_SOURCE_DIR}/third_party/cJSON/CMakeLists.txt")
-    message(FATAL_ERROR "third_party submodules are missing. Run: git submodule update --init --recursive")
-endif()
-
-# ---- cJSON (vendored, static) ----
-set(ENABLE_CJSON_TEST OFF CACHE BOOL "" FORCE)
-set(ENABLE_CJSON_UTILS OFF CACHE BOOL "" FORCE)
-set(BUILD_SHARED_AND_STATIC_LIBS OFF CACHE BOOL "" FORCE)
-set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
-# cJSON declares cmake_minimum_required(VERSION 3.5); CMake 4 warns about < 3.10.
-set(CMAKE_POLICY_VERSION_MINIMUM 3.10)
-add_subdirectory(third_party/cJSON EXCLUDE_FROM_ALL)
-unset(CMAKE_POLICY_VERSION_MINIMUM)
-
-# ---- curl (vendored, static, trimmed to what this tool needs) ----
-set(BUILD_CURL_EXE OFF CACHE BOOL "" FORCE)
-set(BUILD_TESTING OFF CACHE BOOL "" FORCE)
-set(BUILD_LIBCURL_DOCS OFF CACHE BOOL "" FORCE)
-set(BUILD_MISC_DOCS OFF CACHE BOOL "" FORCE)
-set(ENABLE_CURL_MANUAL OFF CACHE BOOL "" FORCE)
-set(CURL_USE_OPENSSL ON CACHE BOOL "" FORCE)
-set(CURL_USE_LIBPSL OFF CACHE BOOL "" FORCE)
-set(CURL_USE_LIBSSH2 OFF CACHE BOOL "" FORCE)
-set(CURL_DISABLE_LDAP ON CACHE BOOL "" FORCE)
-set(CURL_ZLIB OFF CACHE BOOL "" FORCE)
-set(CURL_BROTLI OFF CACHE BOOL "" FORCE)
-set(CURL_ZSTD OFF CACHE BOOL "" FORCE)
-set(USE_NGHTTP2 OFF CACHE BOOL "" FORCE)
-set(USE_LIBIDN2 OFF CACHE BOOL "" FORCE)
-add_subdirectory(third_party/curl EXCLUDE_FROM_ALL)
+find_package(PkgConfig REQUIRED)
+pkg_check_modules(CURL REQUIRED IMPORTED_TARGET libcurl)
+pkg_check_modules(CJSON REQUIRED IMPORTED_TARGET libcjson)
 
 # ---- stock_monitor ----
 add_executable(stock_monitor monitor.c)
-target_link_libraries(stock_monitor PRIVATE libcurl_static cjson)
+target_link_libraries(stock_monitor PRIVATE PkgConfig::CURL PkgConfig::CJSON)
+
+install(TARGETS stock_monitor RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR})
 
 file(COPY_FILE "${CMAKE_SOURCE_DIR}/tickers.txt" "${CMAKE_BINARY_DIR}/tickers.txt" ONLY_IF_DIFFERENT)

